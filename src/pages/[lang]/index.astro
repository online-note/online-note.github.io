---
import Layout from '../../layouts/Layout.astro';
import Notepad from '../../components/Notepad';
import ThemeToggle from '../../components/ThemeToggle';
import LanguagePicker from '../../components/LanguagePicker.astro';
import { ui, type SupportedLanguage } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'ja' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const dict = ui[lang] || ui.en;
---

<Layout lang={lang}>
  <!-- Semantic Primary H1 for 100% SEO Keyword Matching -->
  <h1 class="sr-only">{t('site.title')}</h1>

  <!-- Header -->
  <header class="w-full border-b border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-3 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-2">
      <!-- Logo / Brand -->
      <a href={`/${lang}/`} class="flex items-center gap-2 sm:gap-2.5 group focus:outline-none focus:ring-2 focus:ring-blue-500/50 rounded-xl p-1 shrink-0" aria-label={t('site.name')}>
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-blue-600 dark:bg-blue-600 flex items-center justify-center text-white shadow-xs shadow-blue-500/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <div class="hidden sm:block">
          <span class="text-sm sm:text-lg font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-1.5">
            {t('site.name')}
            <span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300">
              Free
            </span>
          </span>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-none">
            {t('site.tagline')}
          </p>
        </div>
      </a>

      <!-- Right Actions: Support, Language & Theme -->
      <div class="flex items-center gap-1.5 sm:gap-2.5 shrink-0">
        <a
          href="https://buymeacoffee.com/kisharadilz"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 sm:py-2 text-xs sm:text-sm font-semibold rounded-xl text-amber-950 dark:text-amber-200 bg-amber-400/90 hover:bg-amber-400 dark:bg-amber-500/20 dark:hover:bg-amber-500/30 border border-amber-300/80 dark:border-amber-500/30 transition-all shadow-xs hover:shadow hover:scale-102 active:scale-95 group"
          title={t('nav.support')}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-900 dark:text-amber-300 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
            <line x1="6" y1="1" x2="6" y2="4"></line>
            <line x1="10" y1="1" x2="10" y2="4"></line>
            <line x1="14" y1="1" x2="14" y2="4"></line>
          </svg>
          <span class="hidden md:inline">{t('nav.support')}</span>
          <span class="md:hidden">{t('nav.supportShort')}</span>
        </a>

        <LanguagePicker currentLang={lang} />
        <ThemeToggle
          client:load
          ariaLabel={t('theme.toggle')}
          lightLabel={t('theme.light')}
          darkLabel={t('theme.dark')}
        />
      </div>
    </div>
  </header>

  <!-- Main Notepad App Viewport -->
  <main class="flex-grow flex flex-col px-2 sm:px-4 md:px-6 py-2 sm:py-4 md:py-6 max-w-6xl w-full mx-auto">
    <Notepad client:load dict={dict} lang={lang} />

    <!-- How-To Guide Section (SEO Optimized) -->
    <section class="mt-10 sm:mt-16 pt-8 border-t border-slate-200/80 dark:border-slate-800/80">
      <div class="text-center max-w-2xl mx-auto mb-8 px-2">
        <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {t('howto.title')}
        </h2>
        <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm md:text-base text-slate-600 dark:text-slate-400">
          {t('howto.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 font-bold flex items-center justify-center mb-3">1</div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">{t('howto.step1.title')}</h3>
          <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-400">{t('howto.step1.desc')}</p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 font-bold flex items-center justify-center mb-3">2</div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">{t('howto.step2.title')}</h3>
          <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-400">{t('howto.step2.desc')}</p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs">
          <div class="w-8 h-8 rounded-lg bg-indigo-100 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 font-bold flex items-center justify-center mb-3">3</div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">{t('howto.step3.title')}</h3>
          <p class="mt-1 text-xs sm:text-sm text-slate-600 dark:text-slate-400">{t('howto.step3.desc')}</p>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="mt-10 sm:mt-16 pt-8 border-t border-slate-200/80 dark:border-slate-800/80">
      <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12 px-2">
        <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {t('features.title')}
        </h2>
        <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm md:text-base text-slate-600 dark:text-slate-400">
          {t('features.subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-6">
        <!-- Feature 1: Privacy -->
        <div class="p-4 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md transition-shadow">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-3 sm:mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
            {t('features.privacy.title')}
          </h3>
          <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('features.privacy.desc')}
          </p>
        </div>

        <!-- Feature 2: Auto-Save -->
        <div class="p-4 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md transition-shadow">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-blue-100 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center mb-3 sm:mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
            {t('features.autosave.title')}
          </h3>
          <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('features.autosave.desc')}
          </p>
        </div>

        <!-- Feature 3: PDF Export -->
        <div class="p-4 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md transition-shadow">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-indigo-100 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-3 sm:mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="12" y1="18" x2="12" y2="12"></line>
              <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
            {t('features.pdf.title')}
          </h3>
          <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('features.pdf.desc')}
          </p>
        </div>

        <!-- Feature 4: Offline -->
        <div class="p-4 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md transition-shadow">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-3 sm:mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="1" y1="1" x2="23" y2="23"></line>
              <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"></path>
              <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"></path>
              <path d="M10.71 5.05A16 16 0 0 1 22.58 9"></path>
              <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
              <line x1="12" y1="20" x2="12.01" y2="20"></line>
            </svg>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
            {t('features.offline.title')}
          </h3>
          <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('features.offline.desc')}
          </p>
        </div>

        <!-- Feature 5: Distraction Free -->
        <div class="p-4 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md transition-shadow">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center mb-3 sm:mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
              <path d="M21 8V5a2 2 0 0 0-2-2h-3"></path>
              <path d="M3 16v3a2 2 0 0 0 2 2h3"></path>
              <path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
            </svg>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
            {t('features.responsive.title')}
          </h3>
          <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('features.responsive.desc')}
          </p>
        </div>

        <!-- Feature 6: Dark & Light -->
        <div class="p-4 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md transition-shadow">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-3 sm:mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
            {t('features.darkmode.title')}
          </h3>
          <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('features.darkmode.desc')}
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion Section (100% Crawlable & SEO Optimized) -->
    <section class="mt-10 sm:mt-16 pt-8 border-t border-slate-200/80 dark:border-slate-800/80">
      <div class="text-center max-w-2xl mx-auto mb-8 px-2">
        <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {t('faq.title')}
        </h2>
        <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm md:text-base text-slate-600 dark:text-slate-400">
          {t('faq.subtitle')}
        </p>
      </div>

      <div class="max-w-3xl mx-auto space-y-3">
        {
          [1, 2, 3, 4, 5].map((idx) => {
            const qKey = `faq.q${idx}` as any;
            const aKey = `faq.a${idx}` as any;
            return (
              <details class="group rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs p-4 sm:p-5 transition-all">
                <summary class="flex items-center justify-between font-semibold text-sm sm:text-base text-slate-900 dark:text-slate-100 cursor-pointer list-none select-none">
                  <span>{t(qKey)}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed border-t border-slate-100 dark:border-slate-800/60 pt-3">
                  {t(aKey)}
                </p>
              </details>
            );
          })
        }
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="w-full border-t border-slate-200/80 dark:border-slate-800/80 bg-white/50 dark:bg-slate-950/50 mt-12 sm:mt-16 py-6 sm:py-8 safe-p-bottom">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 text-xs text-slate-500 dark:text-slate-400 text-center sm:text-left">
      <div class="flex items-center gap-2 flex-wrap justify-center sm:justify-start">
        <span class="font-semibold text-slate-700 dark:text-slate-300">{t('site.name')}</span>
        <span>•</span>
        <span>{t('footer.privacyNote')}</span>
      </div>

      <div class="flex items-center gap-4">
        <span>© {new Date().getFullYear()} {t('site.name')}. {t('footer.rights')}</span>
        <a
          href="https://github.com/online-note/online-note.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors"
          aria-label={t('nav.github')}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
          </svg>
        </a>
      </div>
    </div>
  </footer>
</Layout>
